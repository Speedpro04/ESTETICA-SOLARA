:{$PORT:80} {
    root * /app/dist
    encode zstd gzip
    file_server

    # Endereço inexistente devolve 404 de verdade, com a página da marca.
    # Antes havia um `try_files {path} /index.html`, que entregava a home com
    # status 200 para qualquer caminho — o "soft 404" que o Google reclama:
    # /blog, /precos e qualquer link errado viravam cópias da home aos olhos do
    # indexador. Não há rota de cliente a preservar: as telas do app são estado
    # interno, não caminho na URL.
    handle_errors {
        rewrite * /404.html
        # `status` explícito: sem ele o file_server responderia 200 servindo a
        # página de erro — trocaria um soft 404 por outro. {err.status_code}
        # preserva o código real (404, 403, 500).
        file_server {
            status {err.status_code}
        }
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Um ano, com subdomínios. Só faz efeito em resposta HTTPS — quem
        # termina o TLS é o proxy do EasyPanel, e o cabeçalho atravessa.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Ativos com hash no nome (assets/app-D6oEKuly.js) nunca mudam de conteúdo:
    # cache de um ano é seguro. O index.html fica de fora de propósito — se ele
    # for cacheado por um ano, um deploy novo não chega para quem já visitou.
    @imutavel {
        path /assets/*
        path *.woff *.woff2
    }
    header @imutavel Cache-Control "public, max-age=31536000, immutable"

    # Imagens e favicon vivem na raiz e podem ser trocados sem mudar de nome:
    # uma semana, com revalidação.
    @midia {
        path *.webp *.avif *.jpg *.jpeg *.png *.svg *.ico
    }
    header @midia Cache-Control "public, max-age=604800, must-revalidate"

    # O HTML precisa ser sempre verificado, senão o deploy demora a aparecer.
    @html {
        path / *.html
    }
    header @html Cache-Control "public, max-age=0, must-revalidate"

    # robots e sitemap: buscador deve ver a versão nova rápido.
    @seo {
        path /robots.txt /sitemap.xml
    }
    header @seo Cache-Control "public, max-age=3600"
}
